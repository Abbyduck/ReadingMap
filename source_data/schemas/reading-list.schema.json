{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readingmap.local/schemas/reading-list.schema.json",
  "title": "Reading Map stable reading list source document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "creator", "list", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "document_type": { "const": "reading_list" },
    "creator": { "$ref": "#/$defs/creator" },
    "list": { "$ref": "#/$defs/list" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "freeObject": { "type": "object", "additionalProperties": true },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "introduction", "other_info"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "introduction": { "$ref": "#/$defs/nullableString" },
        "other_info": { "$ref": "#/$defs/freeObject" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "other_info"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/nullableString" },
        "other_info": { "$ref": "#/$defs/freeObject" }
      }
    },
    "recommendedAge": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "min", "max", "unit"],
          "properties": {
            "raw": { "$ref": "#/$defs/nullableString" },
            "min": { "$ref": "#/$defs/nullableNumber" },
            "max": { "$ref": "#/$defs/nullableNumber" },
            "unit": { "const": "years" }
          }
        }
      ]
    },
    "metric": {
      "oneOf": [
        { "type": "null" },
        { "type": "number" },
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "value", "min", "max"],
          "properties": {
            "raw": { "$ref": "#/$defs/nullableString" },
            "value": { "$ref": "#/$defs/nullableNumber" },
            "min": { "$ref": "#/$defs/nullableNumber" },
            "max": { "$ref": "#/$defs/nullableNumber" }
          }
        }
      ]
    },
    "note": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "extracted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "recommended_age", "ar", "lexile", "level", "comment", "note", "other_info"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "recommended_age": { "$ref": "#/$defs/recommendedAge" },
        "ar": { "$ref": "#/$defs/metric" },
        "lexile": { "$ref": "#/$defs/metric" },
        "level": { "type": ["string", "null"] },
        "recommendation_strength": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
        "recommendation_strength_text": { "$ref": "#/$defs/nullableString" },
        "comment": { "$ref": "#/$defs/nullableString" },
        "note": { "$ref": "#/$defs/note" },
        "other_info": { "$ref": "#/$defs/freeObject" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["possible_entity_type", "confidence", "notes", "other_info"],
      "properties": {
        "possible_entity_type": { "enum": ["book", "animation", "reading_system", "series", "level", "set", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "array", "items": { "type": "string" } },
        "other_info": { "$ref": "#/$defs/freeObject" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "position", "raw_title", "extracted", "analysis"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "position": { "type": ["integer", "null"], "minimum": 0 },
        "raw_title": { "type": "string", "minLength": 1 },
        "extracted": { "$ref": "#/$defs/extracted" },
        "analysis": { "$ref": "#/$defs/analysis" }
      }
    }
  }
}
