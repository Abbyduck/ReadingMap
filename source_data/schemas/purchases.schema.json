{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readingmap.local/schemas/purchases.schema.json",
  "title": "Reading Map stable purchases source document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "source", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "document_type": { "const": "purchases" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description", "other_info"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "other_info": { "type": "object", "additionalProperties": true }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_row", "raw_title", "quantity", "paid_amount", "platform", "purchased_at", "stated_age", "screenshot", "raw_order_text", "other_info"],
      "properties": {
        "source_row": { "type": ["integer", "null"], "minimum": 1 },
        "raw_title": { "type": "string", "minLength": 1 },
        "quantity": { "type": ["integer", "null"], "minimum": 0 },
        "paid_amount": { "type": ["number", "string", "null"] },
        "platform": { "$ref": "#/$defs/nullableString" },
        "purchased_at": { "$ref": "#/$defs/nullableString" },
        "stated_age": { "$ref": "#/$defs/nullableString" },
        "screenshot": { "$ref": "#/$defs/nullableString" },
        "raw_order_text": { "$ref": "#/$defs/nullableString" },
        "other_info": { "type": "object", "additionalProperties": true }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "raw_title", "extracted", "purchase", "analysis", "other_info"],
      "properties": {
        "position": { "type": ["integer", "null"], "minimum": 0 },
        "raw_title": { "type": "string", "minLength": 1 },
        "extracted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 }
          }
        },
        "purchase": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantity", "currency", "total_paid_amount", "records"],
          "properties": {
            "quantity": { "type": "integer", "minimum": 0 },
            "currency": { "type": ["string", "null"] },
            "total_paid_amount": { "type": ["number", "null"] },
            "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["possible_entity_type", "confidence", "notes"],
          "properties": {
            "possible_entity_type": { "enum": ["book", "animation", "reading_system", "series", "level", "set", "unknown"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "other_info": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
