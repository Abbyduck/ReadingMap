# Copy to .env, then run: python scripts/configure_django.py --apply
# Never commit .env or real credentials.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_NAME=reading_map_django
DATABASE_USER=reading_map_app
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:53180,http://localhost:53180
FRONTEND_ORIGIN=http://127.0.0.1:53180

# Optional SMTP settings; local development writes mail to backend/.local/emails/.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Legacy maintenance scripts only: supply DATABASE_URL locally if needed.
# The current Django server uses the DATABASE_* settings above.
